# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/votingdb

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=15m

# AES Encryption key for votes (32 chars)
VOTE_ENCRYPTION_KEY=12345678901234567890123456789012

# Hyperledger Fabric
FABRIC_CHANNEL_NAME=mychannel
FABRIC_CHAINCODE_NAME=voting
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_WALLET_PATH=./fabric/wallet
FABRIC_CONNECTION_PROFILE=./fabric/connection-profile.json

# Admin credentials (for Fabric CA)
FABRIC_ADMIN_ID=admin
FABRIC_ADMIN_SECRET=adminpw
